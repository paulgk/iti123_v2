# Git LFS Configuration
# Track production-ready model files only (experiments stay in GCS/MLflow)

# Keras model files
*.h5 filter=lfs diff=lfs merge=lfs -text

# Model pickle files (only in models/ directory, not data/)
models/**/*.pkl filter=lfs diff=lfs merge=lfs -text

# ONNX model files (future export)
*.onnx filter=lfs diff=lfs merge=lfs -text
